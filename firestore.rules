rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null || isAdmin();
      allow delete: if isAdmin();
    }
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin();
    }
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null || isAdmin();
      allow update: if request.auth != null || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || isAdmin();
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if request.auth != null || isAdmin();
      }
    }
    match /hashtags/{hashtag} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null; // Any logged-in user can create a report
      allow update, delete: if isAdmin();
    }
    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if request.auth != null && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow update, delete: if isAdmin();
      }
    }
  }
}
